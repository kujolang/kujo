{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.ai/schemas/workflow-control/evaluation-result/v1.json",
  "title": "Kujo Evaluation Result v1",
  "type": "object",
  "required": ["schema", "result_id", "evaluator", "subject", "verdict", "severity", "checks", "started_at", "finished_at", "evidence"],
  "properties": {
    "schema": {"const": "kujo.evaluation-result/v1"},
    "result_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "evaluator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "subject": {"$ref": "#/$defs/subject"},
    "verdict": {"enum": ["pass", "fail", "warn", "indeterminate"]},
    "severity": {"enum": ["info", "warning", "error", "critical"]},
    "checks": {
      "type": "object",
      "required": ["passed", "failed", "warned", "skipped"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "warned": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "input_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 1000},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}, "maxItems": 1000},
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "maxLength": 2000}}
      },
      "maxItems": 1000
    }
  },
  "$defs": {
    "subject": {"type": "object", "required": ["run_id"], "properties": {"run_id": {"type": "string", "minLength": 1}, "step_id": {"type": "string"}, "attempt_id": {"type": "string"}}},
    "reference": {"type": "object", "required": ["$ref"], "properties": {"$ref": {"type": "string", "minLength": 1}}}
  }
}

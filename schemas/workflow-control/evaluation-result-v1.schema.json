{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.ai/schemas/workflow-control/evaluation-result/v1.json",
  "title": "Kujo Evaluation Result v1",
  "type": "object",
  "required": [
    "schema",
    "result_id",
    "evaluator",
    "subject",
    "verdict",
    "severity",
    "checks",
    "started_at",
    "finished_at",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "kujo.evaluation-result/v1"
    },
    "result_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "evaluator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "warn",
        "indeterminate"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "checks": {
      "type": "object",
      "required": [
        "passed",
        "failed",
        "warned",
        "skipped"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "warned": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "maxItems": 1000
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRef"
      },
      "maxItems": 1000
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "maxItems": 1000
    },
    "evaluation_status": {
      "enum": [
        "completed",
        "error",
        "blocked"
      ]
    },
    "rule_ids": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "metrics": {
      "type": "object",
      "maxProperties": 100
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": [
        "run_id"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "producer",
        "subject",
        "kind",
        "uri",
        "media_type",
        "created_at",
        "integrity"
      ],
      "properties": {
        "schema": {
          "const": "kujo.evidence-ref/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "integrity": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "sha256",
                "manifest",
                "unverified"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifest_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "sha256"
                  }
                }
              },
              "then": {
                "required": [
                  "sha256"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "manifest"
                  }
                }
              },
              "then": {
                "required": [
                  "manifest_ref"
                ]
              }
            }
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_schema": {
          "type": [
            "object",
            "null"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "correlation_id": {
          "type": "string",
          "maxLength": 200
        },
        "causation_id": {
          "type": "string",
          "maxLength": 200
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "secret"
          ]
        },
        "redaction": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_required",
                "applied",
                "unknown"
              ]
            },
            "profile": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "retention": {
          "type": "object",
          "required": [
            "owner",
            "policy"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "policy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "retain_until": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "evaluation_status"
        ],
        "properties": {
          "evaluation_status": {
            "enum": [
              "error",
              "blocked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "indeterminate"
          }
        }
      }
    }
  ]
}

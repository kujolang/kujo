{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.ai/schemas/workflow-control/policy-decision/v1.json",
  "title": "Kujo Policy Decision v1",
  "type": "object",
  "required": ["schema", "decision_id", "policy", "inputs", "disposition", "reason", "scope", "in_flight", "decided_at"],
  "properties": {
    "schema": {"const": "kujo.policy-decision/v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "disposition": {"enum": ["continue", "retry", "require_intervention", "fail", "cancel"]},
    "reason": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}}
    },
    "scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["step", "descendants", "branch", "workflow"]},
        "root_step_id": {"type": "string", "minLength": 1}
      }
    },
    "in_flight": {"enum": ["allow_finish", "cancel_cooperative", "terminate"]},
    "preservation": {
      "type": "object",
      "required": ["required", "acceptable_modes"],
      "properties": {
        "required": {"type": "boolean"},
        "acceptable_modes": {"type": "array", "items": {"enum": ["none", "filesystem", "handoff_bundle", "snapshot", "live_pause"]}, "uniqueItems": true},
        "retention_policy": {"type": "string"}
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {"enum": ["resume_from_boundary", "retry_evaluation", "retry_step", "retry_clean", "amend_inputs", "approve_override", "abort", "cancel"]},
      "uniqueItems": true
    },
    "decided_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["$ref"], "properties": {"$ref": {"type": "string", "minLength": 1}}}}
  },
  "allOf": [
    {"if": {"properties": {"disposition": {"const": "require_intervention"}}}, "then": {"required": ["allowed_actions"], "properties": {"allowed_actions": {"minItems": 1}}}}
  ]
}

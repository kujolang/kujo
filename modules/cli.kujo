# First-party CLI token parser spike.
#
# The module owns token semantics only. Help rendering, exit codes, and
# application-specific validation stay with the caller.

func cli_error(index, token, code, message) {
    return {
        "ok": false,
        "error": {
            "index": index,
            "token": token,
            "code": code,
            "message": message
        }
    }
}

func find_entry(spec, token) {
    for entry in spec {
        let long_name := "--" + entry["name"]
        if token == long_name || token == get_default(entry, "short", "") {
            return entry
        }
    }
    return null
}

func option_value(entry, token, argv, index) {
    let kind := entry["kind"]
    if kind == "bool" {
        if token == "--" + entry["name"] || token == get_default(entry, "short", "") {
            return {"ok": true, "value": true, "next_index": index}
        }
        let equals_at := index_of(token, "=")
        if equals_at >= 0 {
            let raw := substring(token, equals_at + 1, len(token))
            if raw == "false" {
                return {"ok": true, "value": false, "next_index": index}
            }
            if raw == "true" {
                return {"ok": true, "value": true, "next_index": index}
            }
            return cli_error(index, token, "invalid_boolean", "boolean flags accept only true or false")
        }
        return cli_error(index, token, "invalid_boolean", "boolean flag has an invalid spelling")
    }

    let equals_at := index_of(token, "=")
    if equals_at >= 0 {
        let raw := substring(token, equals_at + 1, len(token))
        if len(raw) == 0 && get_default(entry, "allow_empty", false) != true {
            return cli_error(index, token, "missing_value", "option value cannot be empty")
        }
        return {"ok": true, "value": raw, "next_index": index}
    }

    if index + 1 >= len(argv) {
        return cli_error(index, token, "missing_value", "option requires a value")
    }

    let next_token := argv[index + 1]
    let next_entry := find_entry(spec, next_token)
    if next_entry != null {
        return cli_error(index, token, "missing_value", "option requires a value before the next flag")
    }
    return {"ok": true, "value": next_token, "next_index": index + 1}
}

export func parse(argv, spec) {
    if !is_array(argv) {
        return cli_error(0, "", "invalid_argv", "argv must be an array")
    }
    if !is_array(spec) {
        return cli_error(0, "", "invalid_spec", "spec must be an array")
    }

    mut positionals := []
    mut options := {}
    mut occurrences := []
    mut end_options := false
    mut index := 0

    while index < len(argv) {
        let token := argv[index]
        if end_options {
            positionals = append(positionals, token)
            index = index + 1
        } else if token == "--" {
            end_options = true
            index = index + 1
        } else if starts_with(token, "--") {
            let equals_at := index_of(token, "=")
            mut lookup_token := token
            if equals_at >= 0 {
                lookup_token = substring(token, 0, equals_at)
            }
            let entry := find_entry(spec, lookup_token)
            if entry == null {
                return cli_error(index, token, "unknown_option", "unknown option")
            }
            let parsed := option_value(entry, token, argv, index)
            if parsed["ok"] != true {
                return parsed
            }
            options[entry["name"]] = parsed["value"]
            occurrences = append(occurrences, {
                "name": entry["name"],
                "value": parsed["value"],
                "index": index
            })
            index = parsed["next_index"] + 1
        } else if starts_with(token, "-") && len(token) > 1 {
            let entry := find_entry(spec, token)
            if entry == null {
                return cli_error(index, token, "unknown_option", "unknown option")
            }
            let parsed := option_value(entry, token, argv, index)
            if parsed["ok"] != true {
                return parsed
            }
            options[entry["name"]] = parsed["value"]
            occurrences = append(occurrences, {
                "name": entry["name"],
                "value": parsed["value"],
                "index": index
            })
            index = parsed["next_index"] + 1
        } else {
            positionals = append(positionals, token)
            index = index + 1
        }
    }

    for entry in spec {
        let name := entry["name"]
        let current := get_default(options, name, null)
        if current == null {
            let default_value := get_default(entry, "default", null)
            if default_value != null {
                options[name] = default_value
            } else if entry["kind"] == "bool" {
                options[name] = false
            } else if get_default(entry, "required", false) == true {
                return cli_error(len(argv), "", "missing_required", "required option is missing: " + name)
            }
        }
    }

    mut command := null
    if len(positionals) > 0 {
        command = positionals[0]
        if len(positionals) > 1 {
            mut remaining := []
            mut position := 1
            while position < len(positionals) {
                remaining = append(remaining, positionals[position])
                position = position + 1
            }
            positionals = remaining
        } else {
            positionals = []
        }
    }

    return {
        "ok": true,
        "value": {
            "command": command,
            "positionals": positionals,
            "options": options,
            "occurrences": occurrences
        }
    }
}

# Compatibility adapters for repositories that have historically consumed a
# command-first parsed envelope. They keep command/help/exit policy in the
# caller while sharing the token scan with this first-party package.
export func parse_cli(argv) {
    if !is_array(argv) {
        return {"command": "help", "positionals": [], "flags": {}}
    }
    if len(argv) == 0 {
        return {"command": "help", "positionals": [], "flags": {}}
    }

    command := argv[0]
    mut positionals := []
    mut flags := {}
    mut index := 1
    while index < len(argv) {
        token := argv[index]
        if starts_with(token, "--") {
            equals_at := index_of(token, "=")
            if equals_at >= 0 {
                flag_name := substring(token, 0, equals_at)
                flags[flag_name] = substring(token, equals_at + 1, len(token))
                index = index + 1
                continue
            }
            if index + 1 < len(argv) && starts_with(argv[index + 1], "--") == false {
                flags[token] = argv[index + 1]
                index = index + 2
                continue
            }
            flags[token] = true
            index = index + 1
            continue
        }
        positionals = push(positionals, token)
        index = index + 1
    }
    return {"command": command, "positionals": positionals, "flags": flags}
}

export func parse_args(tokens, bool_flags) {
    if !is_array(tokens) || !is_array(bool_flags) {
        return {"positionals": [], "flags": {}}
    }
    mut positionals := []
    mut flags := {}
    mut index := 0
    while index < len(tokens) {
        token := tokens[index]
        if starts_with(token, "--") {
            key := substring(token, 2, len(token))
            if compat_includes(bool_flags, key) {
                flags[key] = true
            } else if index + 1 < len(tokens) && starts_with(tokens[index + 1], "--") == false {
                flags[key] = tokens[index + 1]
                index = index + 1
            } else {
                flags[key] = ""
            }
        } else {
            positionals = push(positionals, token)
        }
        index = index + 1
    }
    return {"positionals": positionals, "flags": flags}
}

func compat_includes(values, needle) {
    for value in values {
        if value == needle {
            return true
        }
    }
    return false
}

func compat_parsed(value) {
    if type(value) == "dict" {
        return value
    }
    return parse_cli(value)
}

export func has_flag(value, flag_name) {
    parsed := compat_parsed(value)
    return has_key(parsed["flags"], flag_name)
}

export func flag_value(value, flag_name, fallback) {
    parsed := compat_parsed(value)
    if has_key(parsed["flags"], flag_name) {
        return parsed["flags"][flag_name]
    }
    return fallback
}

export func positional(value, index, fallback) {
    parsed := compat_parsed(value)
    values := parsed["positionals"]
    if index >= 0 && index < len(values) {
        return values[index]
    }
    return fallback
}

export func parse_subcommand(argv) {
    if !is_array(argv) || len(argv) == 0 {
        return ""
    }
    if starts_with(argv[0], "-") {
        return ""
    }
    return argv[0]
}

export func positional_args(argv) {
    parsed := compat_parsed(argv)
    return parsed["positionals"]
}

export func print_lines(lines) {
    for line in lines {
        print(to_string(line))
    }
}

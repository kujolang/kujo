# HLP-007: canonical slug, padding, and UTC/time helpers.

let slug := slugify("Release Candidate 1")
let left := pad_start(slug, 24, "0")
let right := pad_end(slug, 24, ".")
let iso := now_utc()
let day := format_date(now_unix(), "YYYY-MM-DD")

assert(slug == "release-candidate-1", "slugify contract drift")
assert(len(left) == 24 && len(right) == 24, "padding contract drift")
assert(len(iso) == 20 && substring(iso, 19, 20) == "Z", "UTC timestamp contract drift")
assert(len(day) == 10, "Unix-seconds date formatting contract drift")

print("ok: HLP-007 canonical text/time helpers")

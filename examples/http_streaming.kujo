# HTTP streaming example
# The deterministic default demonstrates incremental chunk processing. For a
# live request, replace sample_data with http_get_stream(url).

func process_chunks(data, chunk_size) {
    mut offset := 0
    mut chunks := []
    mut chunk_end := 0

    while offset < len(data) {
        chunk_end = min(offset + chunk_size, len(data))
        chunks := push(chunks, substring(data, offset, chunk_end))
        offset += chunk_size
    }

    return chunks
}

let sample_data := "Kujo streams bounded data in deterministic chunks."
let chunks := process_chunks(sample_data, 12)
let restored := join(chunks, "")

assert_equal(restored, sample_data)
print("chunk count:", len(chunks))
for chunk in chunks {
    print("chunk:", chunk)
}

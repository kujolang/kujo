# Unary operators

let positive_int := 42
let negative_int := -positive_int
let positive_float := 3.5
let negative_float := -positive_float

let enabled := true
let disabled := !enabled
let restored := !!enabled

let precedence := -5 + 8
let grouped := -(5 + 8)

assert_equal(negative_int, -42)
assert_equal(negative_float, -3.5)
assert_false(disabled)
assert_true(restored)
assert_equal(precedence, 3)
assert_equal(grouped, -13)

print("integer negation:", negative_int)
print("float negation:", negative_float)
print("logical not:", disabled)
print("double logical not:", restored)

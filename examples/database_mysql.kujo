# MySQL database example
# A live server is optional. The executable default builds and validates the
# parameterized statements without opening a network connection.

let connection_string := "mysql://user:password@localhost:3306/kujo_demo"
let create_sql := "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT)"
let insert_sql := "INSERT INTO users (id, name) VALUES (?, ?)"
let select_sql := "SELECT id, name FROM users WHERE id = ?"

let migration := {
    "backend": "mysql",
    "connection": connection_string,
    "statements": [create_sql, insert_sql, select_sql]
}

assert_equal(migration["backend"], "mysql")
assert_equal(len(migration["statements"]), 3)
print("MySQL example configuration:", migration)
print("To run against a server, pass the connection string to db_connect().")

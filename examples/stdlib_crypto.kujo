# Hashing and password examples.
# Uses current stdlib crypto helpers without long-running file churn.

let message := "Hello, Kujo!"
let sha_hash := sha256(message)
let md5_hash := md5(message)

print("message: " + message)
print("sha256 length: " + to_string(len(sha_hash)))
print("md5 length: " + to_string(len(md5_hash)))

let password := "my_secure_password"
let hashed := hash_password(password)

if verify_password(password, hashed) {
    print("password verified")
}

if !verify_password("wrong_password", hashed) {
    print("wrong password rejected")
}

write_file("important.txt", "Important data", {"overwrite": true})
let file_hash := md5_file("important.txt")
print("file md5 length: " + to_string(len(file_hash)))
delete_file("important.txt")

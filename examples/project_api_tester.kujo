# API tester project
# Builds deterministic request cases and evaluates captured responses.

func request_case(name, method, path, expected_status) {
    return {
        "name": name,
        "method": method,
        "path": path,
        "expected_status": expected_status
    }
}

func evaluate(case_data, response) {
    return {
        "name": case_data["name"],
        "passed": response["status"] == case_data["expected_status"],
        "status": response["status"]
    }
}

let cases := [
    request_case("list users", "GET", "/users", 200),
    request_case("create user", "POST", "/users", 201),
    request_case("missing user", "GET", "/users/404", 404)
]
let captured := [{"status": 200}, {"status": 201}, {"status": 404}]

mut index := 0
mut passed := 0
mut result := {}
while index < len(cases) {
    result = evaluate(cases[index], captured[index])
    if result["passed"] {
        passed += 1
    }
    print(result)
    index += 1
}

assert_equal(passed, len(cases))
print("API cases passed:", passed)

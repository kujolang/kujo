func kv(label, value) {
    print(label + ": " + to_string(value))
}

let schema := {
    "type": "object",
    "required": ["name", "scores"],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 2
        },
        "scores": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
            }
        }
    },
    "additionalProperties": false
}

let valid_report := json_schema_validate({
    "name": "Kujo",
    "scores": [95, 88]
}, schema)

let invalid_report := json_schema_validate({
    "name": "K",
    "scores": [101],
    "debug": true
}, schema)

kv("valid", valid_report["valid"])
kv("invalid", invalid_report["valid"])
kv("errors", invalid_report["errors"])

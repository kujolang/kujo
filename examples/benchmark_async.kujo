# Async benchmark example
# Compares sequential awaits with starting work before awaiting it.

async func square(value) {
    return value * value
}

let sequential_start := performance_now()
let first := await square(3)
let second := await square(4)
let sequential_ms := performance_now() - sequential_start

let concurrent_start := performance_now()
let pending_a := square(5)
let pending_b := square(6)
let concurrent_results := await promise_all([pending_a, pending_b])
let concurrent_ms := performance_now() - concurrent_start

print("sequential results:", [first, second])
print("concurrent results:", concurrent_results)
print("sequential ms:", sequential_ms)
print("concurrent ms:", concurrent_ms)

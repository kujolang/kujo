#!/usr/bin/env kujo
# Small markdown-to-HTML converter sketch.
# This is intentionally compact and current-syntax; expand it for a real tool.

func section(title) {
    print("")
    print("== " + title + " ==")
}

func kv(label, value) {
    print("  " + label + ": " + to_string(value))
}

func html_escape(text) {
    mut result := replace(text, "&", "&amp;")
    result = replace(result, "<", "&lt;")
    result = replace(result, ">", "&gt;")
    return result
}

func convert_line(line) {
    if starts_with(line, "# ") {
        let title := substring(line, 2, len(line))
        return "<h1>" + html_escape(title) + "</h1>"
    }

    if starts_with(line, "## ") {
        let title := substring(line, 3, len(line))
        return "<h2>" + html_escape(title) + "</h2>"
    }

    if starts_with(line, "- ") {
        let item := substring(line, 2, len(line))
        return "<li>" + html_escape(item) + "</li>"
    }

    if len(trim(line)) == 0 {
        return ""
    }

    return "<p>" + html_escape(line) + "</p>"
}

func convert_markdown(markdown) {
    let lines := split(markdown, "\n")
    mut html := []

    for line in lines {
        html = push(html, convert_line(line))
    }

    return join(html, "\n")
}

let sample := "# Kujo\nA small markdown converter.\n- parse headings\n- emit HTML"
let html := convert_markdown(sample)

section("Markdown Converter")
kv("input bytes", len(sample))
kv("output bytes", len(html))
print(html)

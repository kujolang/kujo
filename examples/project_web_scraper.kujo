# Web scraper project
# Uses a committed HTML-shaped fixture so the default run is offline.

func text_between(source, opening, closing) {
    let start_index := index_of(source, opening)
    if start_index < 0 {
        return ""
    }

    let content_start := start_index + len(opening)
    let remainder := substring(source, content_start, len(source))
    let end_index := index_of(remainder, closing)
    if end_index < 0 {
        return ""
    }

    return substring(remainder, 0, end_index)
}

let html := "<html><head><title>Kujo News</title></head><body><h1>Local-first tools</h1></body></html>"
let page := {
    "title": text_between(html, "<title>", "</title>"),
    "heading": text_between(html, "<h1>", "</h1>"),
    "links": []
}

assert_equal(page["title"], "Kujo News")
assert_equal(page["heading"], "Local-first tools")
print("scraped page:", page)

# String processing benchmark

func normalize_line(value) {
    let trimmed := trim(value)
    let lowered := to_lower(trimmed)
    return replace(lowered, " ", "-")
}

let source := [
    "  Kujo Language  ",
    "Local First Automation",
    "Deterministic Workflows",
    "Agent Readable Contracts"
]

let started := performance_now()
mut normalized := []
for value in source {
    normalized := push(normalized, normalize_line(value))
}
let elapsed_ms := performance_now() - started

let combined := join(normalized, ",")
assert_true(contains(combined, "kujo-language") == 1)
assert_true(contains(combined, "deterministic-workflows") == 1)
print("normalized:", normalized)
print("combined:", combined)
print("elapsed ms:", elapsed_ms)

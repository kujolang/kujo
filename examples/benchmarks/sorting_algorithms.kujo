# Sorting algorithms benchmark

func insertion_sort(items) {
    mut result := slice(items, 0, len(items))
    mut index := 1
    mut value := 0
    mut position := 0

    while index < len(result) {
        value = result[index]
        position = index - 1

        while position >= 0 && result[position] > value {
            result[position + 1] := result[position]
            position -= 1
        }

        result[position + 1] := value
        index += 1
    }

    return result
}

let sample := [9, 2, 7, 1, 5, 3, 8, 4, 6]
let started := performance_now()
let custom_sorted := insertion_sort(sample)
let custom_ms := performance_now() - started

let builtin_started := performance_now()
let builtin_sorted := sort(sample)
let builtin_ms := performance_now() - builtin_started

assert_equal(custom_sorted, builtin_sorted)
print("input:", sample)
print("sorted:", custom_sorted)
print("insertion sort ms:", custom_ms)
print("built-in sort ms:", builtin_ms)

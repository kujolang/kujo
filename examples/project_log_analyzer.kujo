# Log analyzer project

let log_text := "INFO service started\nWARN cache miss\nERROR request failed\nINFO retry succeeded"
let log_lines := lines(log_text)
mut info_count := 0
mut warning_count := 0
mut error_count := 0

for line in log_lines {
    if starts_with(line, "INFO") {
        info_count += 1
    }
    if starts_with(line, "WARN") {
        warning_count += 1
    }
    if starts_with(line, "ERROR") {
        error_count += 1
    }
}

let summary := {
    "total": len(log_lines),
    "info": info_count,
    "warnings": warning_count,
    "errors": error_count
}

assert_equal(summary["total"], 4)
assert_equal(summary["errors"], 1)
print("log summary:", summary)

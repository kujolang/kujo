# Interactive Quiz Game
# Demonstrates: user input, type conversion, lexical scoping, accumulator pattern

print("quiz_game: interactive example skipped in VM auto-run mode")
exit(0)

func print_lines(lines) {
    for line in lines {
        print(line)
    }
}

func ask_choice(question, a, b, c) {
    print_lines([
        question,
        "  a) " + a,
        "  b) " + b,
        "  c) " + c
    ])
}

func correct() {
    print("✓ Correct!\n")
}

func wrong(message) {
    print("✗ Wrong. " + message + "\n")
}

print_lines([
    "╔════════════════════════════════╗",
    "║     Programming Quiz Game      ║",
    "╚════════════════════════════════╝",
    ""
])

name := input("Enter your name: ")
print("\nWelcome, " + name + "! Let's test your knowledge.")
print("")

# Quiz score (demonstrates accumulator with lexical scoping)
score := 0
total := 0

# Question 1
ask_choice(
    "Question 1: What does CPU stand for?",
    "Central Processing Unit",
    "Computer Personal Unit",
    "Central Program Utility"
)
answer1 := input("Your answer (a/b/c): ")

if answer1 == "a" {
    correct()
    score := score + 1
} else {
    wrong("The answer is 'a'.")
}
total := total + 1

# Question 2
print("Question 2: What is 8 + 7?")
answer2 := input("Your answer: ")

try {
    num := parse_int(answer2)
    if num == 15 {
        correct()
        score := score + 1
    } else {
        wrong("The answer is 15.")
    }
    total := total + 1
} except err {
    print("✗ Invalid number!\n")
    total := total + 1
}

# Question 3
ask_choice(
    "Question 3: Which language is Kujo written in?",
    "Python",
    "Rust",
    "Go"
)
answer3 := input("Your answer (a/b/c): ")

if answer3 == "b" {
    correct()
    score := score + 1
} else {
    wrong("The answer is 'b' (Rust).")
}
total := total + 1

# Question 4
print("Question 4: What is the square root of 144?")
answer4 := input("Your answer: ")

try {
    num := parse_int(answer4)
    if num == 12 {
        correct()
        score := score + 1
    } else {
        wrong("The answer is 12.")
    }
    total := total + 1
} except err {
    print("✗ Invalid number!\n")
    total := total + 1
}

# Question 5
ask_choice(
    "Question 5: What does API stand for?",
    "Advanced Programming Interface",
    "Application Programming Interface",
    "Automated Program Integration"
)
answer5 := input("Your answer (a/b/c): ")

if answer5 == "b" {
    correct()
    score := score + 1
} else {
    wrong("The answer is 'b'.")
}
total := total + 1

# Calculate percentage
# Note: Kujo uses float division
percentage := (score * 100) / total

# Display results
print_lines([
    "═" * 40,
    "           QUIZ RESULTS",
    "═" * 40,
    "Player: " + name,
    "Score: " + score + " / " + total,
    "Percentage: " + percentage + "%",
    ""
])

if score == total {
    print("★ PERFECT SCORE! Excellent work!")
} else {
    if score >= 4 {
        print("★ Great job! You passed!")
    } else {
        if score >= 3 {
            print("○ Not bad! Keep learning!")
        } else {
            print("○ Keep studying and try again!")
        }
    }
}

print_lines([
    "═" * 40,
    "\nThanks for playing, " + name + "!"
])

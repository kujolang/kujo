// Path Utilities Demo
// Demonstrates path manipulation functions from stdlib

func print_lines(lines) {
    for line in lines {
        print(line)
    }
}

func section(title) {
    print("")
    print(title)
}

func kv(label, value) {
    print("  " + label + ": " + to_string(value))
}

print_lines([
    "=== Path Utilities Demo ===",
    ""
])

// Build paths
section("1. Building Paths:")
home_dir := "/home/user"
docs_path := join_path(home_dir, "Documents", "projects", "kujo")
kv("Home directory", home_dir)
kv("Documents path", docs_path)

config_path := join_path(home_dir, ".config", "kujo", "settings.json")
kv("Config path", config_path)

// Extract path components
section("2. Extracting Path Components:")
full_path := "/home/user/projects/kujo/examples/demo.kujo"
kv("Full path", full_path)
kv("Directory", dirname(full_path))
kv("Filename", basename(full_path))

// More path examples
paths := [
    "/usr/local/bin/kujo",
    "src/interpreter.rs",
    "README.md",
    "/etc/config/settings.json"
]

section("3. Path Analysis:")
for path in paths {
    dir := dirname(path)
    file := basename(path)
    kv("Path", path)
    print("    Dir:  " + dir)
    print("    File: " + file)
    print("")
}

// Check if paths exist
section("4. Checking Path Existence:")
test_paths := [
    "Cargo.toml",
    "src",
    "README.md",
    "nonexistent_file.txt",
    "examples"
]

for path in test_paths {
    exists := path_exists(path)
    status := "✗ Not found"
    if exists {
        status := "✓ Exists"
    }
    print("  " + path + ": " + status)
}

// Build a project structure
section("5. Project Structure Builder:")
project_name := "my_app"
base := join_path("projects", project_name)

dirs := [
    base,
    join_path(base, "src"),
    join_path(base, "tests"),
    join_path(base, "docs"),
    join_path(base, "examples")
]

files := [
    join_path(base, "README.md"),
    join_path(base, "Cargo.toml"),
    join_path(base, "src", "main.rs"),
    join_path(base, "src", "lib.rs"),
    join_path(base, "tests", "test_basic.rs")
]

kv("Project", project_name)
print("  Directories to create:")
for dir in dirs {
    print("    " + dir)
}
print("")
print("  Files to create:")
for file in files {
    print("    " + file)
}

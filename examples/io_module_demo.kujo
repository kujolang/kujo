# File I/O example

let path := "/tmp/kujo_io_module_demo.txt"
write_file(path, "first line\n")
append_file(path, "second line\n")

let content := read_file(path)
let content_lines := lines(content)

assert_equal(len(content_lines), 2)
assert_equal(content_lines[0], "first line")
assert_equal(content_lines[1], "second line")
print("file contents:\n" + content)

delete_file(path)
assert_false(file_exists(path))

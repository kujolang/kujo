# Array Utilities Demo
# Demonstrates the new array utility functions added in v0.7.0

func print_lines(lines) {
    for line in lines {
        print(line)
    }
}

func section(title) {
    print("")
    print(title)
}

func kv(label, value) {
    print("   " + label + ": " + to_string(value))
}

func show_result(label, value) {
    print("   " + label + " = " + to_string(value))
    print()
}

print_lines([
    "=== Array Utilities Demo ===",
    ""
])

# Sample data
nums := [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]
kv("Original array", nums)

# 1. Sort - arrange in ascending order
section("1. SORT - Arrange in ascending order")
sorted := sort(nums)
show_result("sort(nums)", sorted)

# 2. Reverse - reverse the order
section("2. REVERSE - Reverse the order")
reversed := reverse(nums)
show_result("reverse(nums)", reversed)

# 3. Unique - remove duplicates
section("3. UNIQUE - Remove duplicates (preserves order)")
unique_nums := unique(nums)
show_result("unique(nums)", unique_nums)

# 4. Sum - calculate total
section("4. SUM - Calculate total")
total := sum(nums)
show_result("sum(nums)", total)

# 5. Any - check if any element satisfies condition
section("5. ANY - Check if any element satisfies condition")
has_large := any(nums, func(x) { return x > 8 })
has_negative := any(nums, func(x) { return x < 0 })
kv("any(nums, x > 8)", has_large)
show_result("any(nums, x < 0)", has_negative)

# 6. All - check if all elements satisfy condition
section("6. ALL - Check if all elements satisfy condition")
all_positive := all(nums, func(x) { return x > 0 })
all_large := all(nums, func(x) { return x > 8 })
kv("all(nums, x > 0)", all_positive)
show_result("all(nums, x > 8)", all_large)

# Chaining operations
section("=== Chaining Operations ===")
print("Get unique values, sort them, and reverse:")
result := reverse(sort(unique(nums)))
show_result("reverse(sort(unique(nums)))", result)

# Working with strings
section("=== Working with Strings ===")
words := ["banana", "apple", "cherry", "apple", "date", "banana"]
kv("Words", words)

sorted_words := sort(words)
kv("Sorted", sorted_words)

unique_words := unique(words)
show_result("Unique", unique_words)

# Practical example: Data analysis
section("=== Practical Example: Student Scores ===")
scores := [85, 92, 78, 92, 88, 95, 78, 90, 88, 85]
kv("Student scores", scores)

# Calculate statistics
total_score := sum(scores)
num_students := len(scores)
average := total_score / num_students
kv("Total", total_score)
kv("Number of students", num_students)
show_result("Average score", average)

# Check performance
has_excellent := any(scores, func(s) { return s >= 90 })
all_passing := all(scores, func(s) { return s >= 60 })
kv("Has excellent (>=90)", has_excellent)
show_result("All passing (>=60)", all_passing)

# Show score distribution
unique_scores := sort(unique(scores))
show_result("Unique scores (sorted)", unique_scores)

# Working with mixed types
section("=== Mixed Integer and Float ===")
mixed := [3, 1.5, 4, 2.2, 5.7, 1]
kv("Mixed array", mixed)
sorted_mixed := sort(mixed)
kv("Sorted", sorted_mixed)
total_mixed := sum(mixed)
show_result("Sum", total_mixed)

# Edge cases
section("=== Edge Cases ===")
empty := []
kv("Empty array", empty)
kv("sum([])", sum(empty))
kv("sort([])", sort(empty))
kv("any([], x > 0)", any(empty, func(x) { return x > 0 }))
show_result("all([], x > 0)", all(empty, func(x) { return x > 0 }))

single := [42]
kv("Single element", single)
kv("reverse([42])", reverse(single))
show_result("unique([42])", unique(single))

print("=== Demo Complete ===")

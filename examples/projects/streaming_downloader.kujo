# Streaming downloader project
# The default run uses fixture content. In a live workflow, obtain data with
# http_get_stream(url), then pass it through the same bounded chunk loop.

func download_receipt(url, data, chunk_size) {
    mut offset := 0
    mut chunk_count := 0
    while offset < len(data) {
        offset += chunk_size
        chunk_count += 1
    }

    return {
        "url": url,
        "bytes": len(data),
        "chunks": chunk_count,
        "sha256": sha256(data)
    }
}

let fixture := "deterministic download fixture"
let receipt := download_receipt("https://example.test/archive.txt", fixture, 8)

assert_equal(receipt["bytes"], len(fixture))
assert_equal(receipt["chunks"], 4)
assert_equal(len(receipt["sha256"]), 64)
print("download receipt:", receipt)

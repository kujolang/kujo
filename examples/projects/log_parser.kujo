# Log parser project example.
# Demonstrates file I/O, splitting, filtering, and simple summaries.

func level_from_line(line) {
    let parts := split(line, " ")
    if len(parts) >= 3 {
        return parts[2]
    }
    return "UNKNOWN"
}

func message_from_line(line) {
    let parts := split(line, " ")
    if len(parts) >= 4 {
        return join(slice(parts, 3, len(parts)), " ")
    }
    return line
}

func count_level(lines, level) {
    mut count := 0
    for line in lines {
        if level_from_line(line) == level {
            count = count + 1
        }
    }
    return count
}

let log_content := "2026-01-22 10:15:23 INFO User login successful: alice@example.com\n2026-01-22 10:16:45 ERROR Database connection failed: timeout\n2026-01-22 10:18:33 WARNING High memory usage: 85%\n2026-01-22 10:24:05 INFO System backup completed successfully"

write_file("app.log", log_content, {"overwrite": true})

let lines := split(read_file("app.log"), "\n")
let errors := filter(lines, func(line) {
    return level_from_line(line) == "ERROR"
})

print("total: " + to_string(len(lines)))
print("info: " + to_string(count_level(lines, "INFO")))
print("warning: " + to_string(count_level(lines, "WARNING")))
print("error: " + to_string(len(errors)))

for line in errors {
    print("error message: " + message_from_line(line))
}

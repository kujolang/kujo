# Contact manager project

func find_contact(contacts, email) {
    for contact in contacts {
        if contact["email"] == email {
            return contact
        }
    }
    return null
}

let contacts := [
    {"name": "Ada", "email": "ada@example.com", "tags": ["engineering"]},
    {"name": "Grace", "email": "grace@example.com", "tags": ["research"]},
    {"name": "Linus", "email": "linus@example.com", "tags": ["systems"]}
]

let match_result := find_contact(contacts, "grace@example.com")
assert_equal(match_result["name"], "Grace")
assert_equal(len(contacts), 3)

for contact in contacts {
    print(contact["name"] + " <" + contact["email"] + ">")
}

# Data pipeline project
# Extracts CSV, transforms rows, and loads a summary in memory.

func normalize_sale(row) {
    return {
        "product": to_lower(row["product"]),
        "quantity": row["quantity"],
        "revenue": row["quantity"] * row["price"]
    }
}

let source := "product,quantity,price\nWidget,3,12\nGadget,2,25\nWidget,1,12"
let extracted := parse_csv(source)
mut transformed := []
mut total_revenue := 0
mut sale := {}

for row in extracted {
    sale = normalize_sale(row)
    transformed := push(transformed, sale)
    total_revenue += sale["revenue"]
}

let loaded := {
    "row_count": len(transformed),
    "total_revenue": total_revenue,
    "rows": transformed
}

assert_equal(loaded["row_count"], 3)
assert_equal(loaded["total_revenue"], 98)
print("pipeline result:", loaded)

# Math helper module-style example.
# Keep this file self-contained so it can be checked or run directly.

const LOCAL_PI := 3.14159

func add(a, b) {
    return a + b
}

func multiply(a, b) {
    return a * b
}

func circle_area(radius) {
    return LOCAL_PI * radius * radius
}

print("5 + 3 = " + to_string(add(5, 3)))
print("4 * 7 = " + to_string(multiply(4, 7)))
print("circle area = " + to_string(circle_area(2)))

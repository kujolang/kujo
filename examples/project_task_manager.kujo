# Task manager project

func task(id, title, done) {
    return {"id": id, "title": title, "done": done}
}

func complete_task(tasks, target_id) {
    mut updated := []
    for item in tasks {
        if item["id"] == target_id {
            updated := push(updated, {...item, "done": true})
        } else {
            updated := push(updated, item)
        }
    }
    return updated
}

let initial_tasks := [
    task(1, "write example", false),
    task(2, "run verification", false),
    task(3, "publish report", false)
]
let tasks := complete_task(initial_tasks, 2)
mut completed := 0

for item in tasks {
    if item["done"] {
        completed += 1
    }
    print(item)
}

assert_equal(completed, 1)
assert_true(tasks[1]["done"])

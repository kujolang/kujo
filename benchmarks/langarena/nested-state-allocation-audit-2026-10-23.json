  "source": "//! Allocation accounting for bytecode call setup; no wall-clock assertions.\nuse kujo::{compiler::Compiler, interpreter::Value, lexer, parser::Parser, vm::VM};\nuse std::alloc::{GlobalAlloc, Layout, System};\nuse std::cell::Cell;\n\nthread_local! {\n    static TRACK: Cell<bool> = const { Cell::new(false) };\n    static ALLOCATIONS: Cell<usize> = const { Cell::new(0) };\n    static REQUESTED_BYTES: Cell<usize> = const { Cell::new(0) };\n}\n\nstruct CountingAllocator;\nfn record(bytes: usize) {\n    let _ = TRACK.try_with(|enabled| {\n        if enabled.get() {\n            ALLOCATIONS.with(|count| count.set(count.get() + 1));\n            REQUESTED_BYTES.with(|count| count.set(count.get() + bytes));\n        }\n    });\n}\n\n// SAFETY: all allocation operations delegate unchanged to System. Accounting\n// uses allocation-free thread-local Cells and never dereferences allocation data.\nunsafe impl GlobalAlloc for CountingAllocator {\n    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {\n        record(layout.size());\n        // SAFETY: caller supplies a valid allocation layout.\n        unsafe { System.alloc(layout) }\n    }\n    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {\n        record(layout.size());\n        // SAFETY: caller supplies a valid allocation layout.\n        unsafe { System.alloc_zeroed(layout) }\n    }\n    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {\n        // SAFETY: ownership and layout requirements are inherited from the caller.\n        unsafe { System.dealloc(ptr, layout) }\n    }\n    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, size: usize) -> *mut u8 {\n        record(size);\n        // SAFETY: pointer, original layout and new size are supplied by the caller.\n        unsafe { System.realloc(ptr, layout, size) }\n    }\n}\n\n#[global_allocator]\nstatic ALLOCATOR: CountingAllocator = CountingAllocator;\n\nfn main() { kujo::benchmarks::profiler::runtime::start().unwrap(); for repeat in 0..3 { for jit in [false, true] {\n    for helper in [false, true] {\n        for saved in [false, true] {\n            for width in [8, 256] {\n                for writes in [200, 1000] {\n                    let rows = std::iter::repeat(\"Node { value: 0 }\").take(width).collect::<Vec<_>>().join(\",\");\n                    let snapshot = if saved { \"let snapshot := state\" } else { \"\" };\n                    let check = if saved { \"assert_equal(snapshot[\\\"nodes\\\"][0].value, 0)\" } else { \"\" };\n                    let body = if helper { \"state = step(state)\\n\" } else { \"state[\\\"nodes\\\"][0].value += 1\\n\" };\n                    let source = format!(\"struct Node {{ value: int }} func step(input) {{ mut state := input state[\\\"nodes\\\"][0].value += 1 return state }} func work() {{ mut state := {{\\\"nodes\\\": [{rows}]}} {snapshot} {} {check} return state[\\\"nodes\\\"][0].value }} return work()\",body.repeat(writes));\n                    let mut parser = Parser::new(lexer::tokenize(&source).unwrap());\n                    let chunk = Compiler::new().compile(&parser.parse()).unwrap();\n                    let mut vm = VM::new();\n                    vm.set_jit_enabled(jit);\n                    ALLOCATIONS.with(|x| x.set(0)); REQUESTED_BYTES.with(|x| x.set(0));\n                    let before = kujo::benchmarks::profiler::runtime::snapshot(\"success\")[\"counters\"][\"jit_native_function_entries\"].as_u64().unwrap();\n                    TRACK.with(|x| x.set(true));\n                    let result=vm.execute(chunk);\n                    TRACK.with(|x| x.set(false));\n                    assert!(matches!(result.unwrap(),Value::Int(n) if n==writes as i64));\n                    let after = kujo::benchmarks::profiler::runtime::snapshot(\"success\")[\"counters\"][\"jit_native_function_entries\"].as_u64().unwrap(); println!(\"native={},repeat={repeat},jit={jit},helper={helper},saved={saved},width={width},writes={writes},allocations={},bytes={}\",after-before,ALLOCATIONS.with(Cell::get),REQUESTED_BYTES.with(Cell::get));\n                }\n            }\n        }\n    }\n}\n\n}}\n",
  "bytecode_audit_source": "use kujo::{compiler::Compiler, lexer, parser::Parser, bytecode::Constant, jit::JitCompiler};\nfn main() {\n let source=std::fs::read_to_string(\"/tmp/kujo-owned-entry-2026-10-23/nested-state-native-gap.kujo\").unwrap();\n let mut parser=Parser::new(lexer::tokenize(&source).unwrap());\n let chunk=Compiler::new().compile(&parser.parse()).unwrap();\n let jit=JitCompiler::new().unwrap();\n for c in chunk.constants.iter() { if let Constant::Function(f)=c { if f.name.as_deref()==Some(\"step\") {\n println!(\"{:?}\",jit.first_unsupported_surface(&f));\n for (i,op) in f.instructions.iter().enumerate() { println!(\"{i}: {op:?}\"); }\n }}}\n}\n",

  "source": "use kujo::{compiler::Compiler, lexer, parser::Parser, bytecode::{BytecodeChunk,Constant,OpCode}, jit::JitCompiler};\nfn scan(chunk: &BytecodeChunk,jit:&JitCompiler) {\n for c in &chunk.constants {\n  if let Constant::Function(f)=c {\n   let name=f.name.as_deref().unwrap_or(\"anonymous\");\n   println!(\"{name}|params={}|captures={}|self={}|closures={}|first={:?}\",f.params.len(),f.upvalues.len(),f.lexical_self.is_some(),f.instructions.iter().any(|op| matches!(op,OpCode::MakeClosure(_))),jit.first_unsupported_surface(f));\n   scan(f,jit);\n  }\n }\n}\nfn main() {\n let source=std::fs::read_to_string(\"benchmarks/langarena/port.kujo\").unwrap();\n let mut parser=Parser::new(lexer::tokenize(&source).unwrap());\n let chunk=Compiler::new().compile(&parser.parse()).unwrap();\n scan(&chunk,&JitCompiler::new().unwrap());\n}\n",

func compress_data(size) {
    let pattern := utf8_encode("ABRACADABRA")
    mut data := bytes(vector(size, 0))
    mut i := 0
    while i < size { data[i] = pattern[i % byte_length(pattern)] i += 1 }
    return data
}
func bwt_encode(data) {
    let n := byte_length(data)
    if n == 0 { return [bytes([]), 0] }
    mut counts := vector(256, 0)
    for b in data { counts[b] += 1 }
    mut positions := vector(256, 0)
    mut total := 0
    mut i := 0
    while i < 256 { positions[i] = total total += counts[i] i += 1 }
    mut sa := vector(n, 0)
    mut used := vector(256, 0)
    i = 0
    while i < n { let b := data[i] sa[positions[b] + used[b]] = i used[b] += 1 i += 1 }
    if n > 1 {
        mut ranks := vector(n, 0)
        mut rank := 0
        mut previous := data[sa[0]]
        for index in sa { if data[index] != previous { rank += 1 previous = data[index] } ranks[index] = rank }
        mut k := 1
        while k < n {
            mut pairs := []
            i = 0
            while i < n { pairs = push(pairs, [ranks[i], ranks[(i + k) % n]]) i += 1 }
            func compare(a, b) { if pairs[a][0] != pairs[b][0] { return pairs[a][0] - pairs[b][0] } return pairs[a][1] - pairs[b][1] }
            sa = sort_by(sa, compare)
            mut next := vector(n, 0)
            i = 1
            while i < n { let prev := sa[i - 1] let curr := sa[i] next[curr] = next[prev] if pairs[prev] != pairs[curr] { next[curr] += 1 } i += 1 }
            ranks = next
            k *= 2
        }
    }
    mut transformed := bytes(vector(n, 0))
    mut original := 0
    i = 0
    while i < n {
        if sa[i] == 0 { transformed[i] = data[n - 1] original = i }
        else { transformed[i] = data[sa[i] - 1] }
        i += 1
    }
    return [transformed, original]
}
func bwt_decode(encoded) {
    let data := encoded[0]
    let n := byte_length(data)
    mut counts := vector(256, 0)
    for b in data { counts[b] += 1 }
    mut positions := vector(256, 0)
    mut total := 0
    mut i := 0
    while i < 256 { positions[i] = total total += counts[i] i += 1 }
    mut next := vector(n, 0)
    mut used := vector(256, 0)
    i = 0
    while i < n { let b := data[i] next[positions[b] + used[b]] = i used[b] += 1 i += 1 }
    mut result := bytes(vector(n, 0))
    mut index := encoded[1]
    i = 0
    while i < n { index = next[index] result[i] = data[index] i += 1 }
    return result
}
func bwt_prepare(input) {
    mut state := input
    state["data"] = compress_data(state["cfg"]["size"])
    if state["cfg"]["name"] == "Compress::BWTDecode" { state["encoded"] = bwt_encode(state["data"]) }
    return state
}
func bwt_run(input, iteration) {
    mut state := input
    if state["cfg"]["name"] == "Compress::BWTEncode" { state["encoded"] = bwt_encode(state["data"]) state["result"] += byte_length(state["encoded"][0]) }
    else { state["decoded"] = bwt_decode(state["encoded"]) state["result"] += byte_length(state["decoded"]) }
    state["result"] = u32(state["result"])
    return state
}
func compress_decode_checksum(state) { if state["decoded"] == state["data"] { return u32(state["result"] + 100000) } return state["result"] }
registry["Compress::BWTEncode"] = [basic_state, bwt_prepare, bwt_run, result_checksum]
registry["Compress::BWTDecode"] = [basic_state, bwt_prepare, bwt_run, compress_decode_checksum]

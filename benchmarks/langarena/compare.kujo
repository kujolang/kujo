# Usage: kujo run benchmarks/langarena/compare.kujo --scheduler-no-timeout KUJO RUST GOOSE OUTPUT_DIRECTORY [vm|jit|interpreter] [ROUNDS]
# Build competitors first. Run from the repository root. Never run concurrent samples.
let options := args()
assert(len(options) >= 4 && len(options) <= 6, "Expected binaries, output directory, optional runtime and rounds")
mut runtime := "vm"
if len(options) >= 5 { runtime = options[4] }
assert(runtime == "vm" || runtime == "jit" || runtime == "interpreter", "Unknown runtime")
mut rounds := 3
if len(options) >= 6 { rounds = to_int(options[5]) }
assert(rounds >= 1 && rounds <= 100, "Rounds must be between 1 and 100")
let binaries := {"Kujo": options[0], "Rust": options[1], "Goose": options[2]}
let directory := options[3]
let cases := [
    ["Base64::Encode", "benchmarks/langarena/run.json"],
    ["Json::Generate", "benchmarks/langarena/run.json"],
    ["Etc::LogParser", "benchmarks/langarena/run.json"],
    ["Sort::Quick", "benchmarks/langarena/test.json"]
]
let languages := ["Kujo", "Rust", "Goose"]

# Time only the measured loop, as the upstream Rust and Goose runners do.
# Assemble a temporary copy; preserve the normal port and all benchmark kernels.
let source := read_file("benchmarks/langarena/port.kujo")
let begin := "            while i < cfg[\"iterations\"] {"
let end := "            let actual := u32(checksum(state))"
assert_equal(len(split(source, begin)), 2)
assert_equal(len(split(source, end)), 2)
let timed := replace(replace(source, begin, "            let comparison_started := time_ns()\n" + begin), end, "            let comparison_elapsed := time_ns() - comparison_started\n            print(\"@comparison_ns \" + str(comparison_elapsed))\n" + end)
let port := directory + "/timed-port.kujo"
write_file(port, timed, true)
mut results := []
mut round := 0
while round < rounds {
    for selected in cases {
        let name := selected[0]
        let config := selected[1]
        mut index := 0
        while index < 3 {
            let language := languages[(index + round) % 3]
            print("START round=" + str(round + 1) + " " + name + " " + language)
            mut command := [binaries[language], config, name]
            if language == "Kujo" {
                command = [binaries[language], "run", port, "--scheduler-no-timeout"]
                if runtime == "jit" { command = push(command, "--jit") }
                if runtime == "interpreter" { command = push(command, "--interpreter") }
                command = push(push(command, config), name)
            }
            let started := time_ns()
            let result := spawn_process(command, {"timeout_ms": 600000, "max_output_bytes": 1048576})
            let wall := time_ns() - started
            mut measured := -1.0
            mut passed := false
            if language == "Kujo" {
                passed = result.success && contains(result.stdout, name + ": OK ") == 1 && contains(result.stdout, "Summary: 1, 1, 0") == 1
                for line in split(result.stdout, "\n") {
                    if starts_with(line, "@comparison_ns ") { measured = to_float(split(line, " ")[1]) / 1000000000.0 }
                }
            } else {
                let prefix := name + ": OK in "
                passed = result.success && contains(result.stdout, prefix) == 1 && contains(result.stdout, ", 1, 1, 0") == 1
                for line in split(result.stdout, "\n") {
                    if starts_with(line, prefix) {
                        let duration := split(line, " in ")[1]
                        measured = to_float(substring(duration, 0, len(duration) - 1))
                    }
                }
            }
            let valid := passed && measured >= 0.0
            results = push(results, {"round": round + 1, "benchmark": name, "config": config, "language": language, "passed": valid, "measured_seconds": measured, "wall_seconds": to_float(wall) / 1000000000.0, "exitcode": result.exitcode, "timed_out": result.timed_out, "stdout": result.stdout, "stderr": result.stderr})
            write_file(directory + "/samples.json", to_json({"binaries": binaries, "kujo_runtime": runtime, "rounds": rounds, "results": results}), true)
            assert(valid, language + " " + name + ": " + result.stdout + result.stderr)
            print("PASS measured_seconds=" + str(measured))
            index += 1
        }
    }
    round += 1
}

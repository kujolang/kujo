# Run from the repository root: BEFORE AFTER EXISTING_OUTPUT_DIRECTORY.
# Unchanged test-size QuickSort, rotating before/after VM/JIT execution order.
let options := args()
assert_equal(len(options), 3)
let binaries := [options[0], options[1]]
let directory := options[2]
let source := read_file("benchmarks/langarena/port.kujo")
let begin := "            while i < cfg[\"iterations\"] {"
let end := "            let actual := u32(checksum(state))"
assert_equal(len(split(source, begin)), 2)
assert_equal(len(split(source, end)), 2)
let timed := replace(replace(source, begin, "            let comparison_started := time_ns()\n" + begin), end, "            let comparison_elapsed := time_ns() - comparison_started\n            print(\"@comparison_ns \" + str(comparison_elapsed))\n" + end)
let port := directory + "/timed-port.kujo"
write_file(port, timed, true)
mut results := []
mut round := 0
while round < 7 {
    mut slot := 0
    while slot < 4 {
        let variant := (slot + round) % 4
        let after := variant % 2
        let jit := variant >= 2
        mut command := [binaries[after], "run", port, "--scheduler-no-timeout"]
        if jit { command = push(command, "--jit") }
        command = push(push(command, "benchmarks/langarena/test.json"), "Sort::Quick")
        print("START round=" + str(round + 1) + " variant=" + str(variant))
        let started := time_ns()
        let result := spawn_process(command, {"timeout_ms": 600000, "max_output_bytes": 1048576})
        let wall := time_ns() - started
        mut measured := -1.0
        for line in split(result.stdout, "\n") {
            if starts_with(line, "@comparison_ns ") { measured = to_float(split(line, " ")[1]) / 1000000000.0 }
        }
        let passed := result.success && measured >= 0.0 && contains(result.stdout, "Sort::Quick: OK ") == 1 && contains(result.stdout, "Summary: 1, 1, 0") == 1
        results = push(results, {"round": round + 1, "variant": variant, "after": after == 1, "jit": jit, "passed": passed, "measured_seconds": measured, "wall_seconds": to_float(wall) / 1000000000.0, "stdout": result.stdout, "stderr": result.stderr})
        write_file(directory + "/samples.json", to_json({"binaries": binaries, "rounds": 7, "results": results}), true)
        assert(passed, result.stdout + result.stderr)
        print("PASS seconds=" + str(measured))
        slot += 1
    }
    round += 1
}

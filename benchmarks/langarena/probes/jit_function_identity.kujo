func factory() {
    func read(x) { return x + 1 }
    let before := read
    func read(x) { return x + 2 }
    return [before, read]
}
let readers := factory()
mut i := 0
while i < 200 {
    assert_equal(readers[0](5), 6)
    i += 1
}
assert_equal(readers[1](5), 7)
assert_equal(readers[0](5), 6)
print("PASS")

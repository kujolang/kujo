func integer_mix(iterations) {
    mut accumulator := 1
    mut i := 1

    while i <= iterations {
        accumulator = (accumulator * 1664525 + i + 1013904223) % 2147483647
        i += 1
    }

    return accumulator
}

let result := integer_mix(250000)
print("integer_mix=" + to_string(result))

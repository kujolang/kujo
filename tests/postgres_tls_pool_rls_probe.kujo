# Inventory: skip (requires the real TLS PostgreSQL integration environment)
let connection_string := env_or("KUJO_POSTGRES_TLS_URL", "")
let killer_connection_string := env_or("KUJO_POSTGRES_TLS_ADMIN_URL", "")
let ca_pem := read_file(env_or("KUJO_POSTGRES_TLS_CA_FILE", ""))
let run_id := env_or("KUJO_POSTGRES_TEST_RUN", "run")
let rolled_back_command := "rolled-back-command-" + run_id
let rolled_back_event := "rolled-back-event-" + run_id
let committed_command := "committed-command-" + run_id
let committed_event := "committed-event-" + run_id
let committed_outbox := "committed-outbox-" + run_id
let fault_command := "fault-command-" + run_id
let fault_event := "fault-event-" + run_id
let fault_outbox := "fault-outbox-" + run_id

let pool := db_pool_postgres_tls(connection_string, ca_pem, {
    "min_connections": 2,
    "max_connections": 2,
    "acquisition_timeout_ms": 500,
    "connect_timeout_ms": 3000,
    "idle_timeout_seconds": 60,
    "max_lifetime_seconds": 300,
    "statement_timeout_ms": 3000,
    "health_check": true
})
if type(pool) == "error" { throw("verified PostgreSQL TLS pool creation failed") }
let initial := db_pool_stats(pool)
if initial["available"] != 2 || initial["total"] != 2 || initial["in_use"] != 0 { throw("verified PostgreSQL TLS pool warm-up failed") }

let db := db_pool_acquire(pool)
let worker := db_pool_acquire(pool)
let tls := db_query(db, "SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()", [])
if len(tls) != 1 || tls[0]["ssl"] != true { throw("pooled PostgreSQL transport is not TLS") }
let migration := db_query(db, "SELECT version::BIGINT AS version FROM qf_schema_migrations", [])
if len(migration) != 1 || migration[0]["version"] != 1 { throw("empty-database migration did not apply") }
let role := db_query(db, "SELECT r.rolsuper, r.rolbypassrls, r.rolcreaterole, r.rolcreatedb, EXISTS (SELECT 1 FROM pg_class c WHERE c.relname = 'qf_tenant_rows' AND c.relowner = r.oid) AS owns_table FROM pg_roles r WHERE r.rolname = current_user", [])
if len(role) != 1 || role[0]["rolsuper"] != false || role[0]["rolbypassrls"] != false || role[0]["rolcreaterole"] != false || role[0]["rolcreatedb"] != false || role[0]["owns_table"] != false { throw("application role separation failed") }

# Missing context exposes no data and cannot write tenant rows.
let missing := db_query(db, "SELECT COUNT(*)::BIGINT AS count FROM qf_tenant_rows", [])
if missing[0]["count"] != 0 { throw("missing tenant context exposed rows") }
let missing_write := db_query(db, "SELECT qf_try_insert('tenant_a', $1) AS inserted", ["missing-context-" + run_id])
if missing_write[0]["inserted"] != false { throw("missing tenant context allowed a write") }

db_execute(db, "SET app.organization_id = 'tenant_a'", [])
db_execute(db, "UPDATE qf_jobs SET status = 'ready', claimed_by = NULL, leased_until = NULL", [])
let visible := db_query(db, "SELECT organization_id, value FROM qf_tenant_rows ORDER BY organization_id", [])
if len(visible) != 1 || visible[0]["organization_id"] != "tenant_a" { throw("database RLS did not isolate tenant A") }
let joined := db_query(db, "SELECT COUNT(*)::BIGINT AS count FROM qf_tenant_rows a JOIN qf_tenant_rows b ON true WHERE b.organization_id = 'tenant_b'", [])
if joined[0]["count"] != 0 { throw("RLS leaked tenant B through a join") }
let exported := db_query(db, "SELECT COALESCE(string_agg(organization_id || ':' || value, ','), '') AS export FROM qf_tenant_rows", [])
if exported[0]["export"] != "tenant_a:A" { throw("RLS leaked tenant B through export-shaped query") }
let cross_insert := db_query(db, "SELECT qf_try_insert('tenant_b', $1) AS inserted", ["cross-insert-" + run_id])
if cross_insert[0]["inserted"] != false { throw("RLS WITH CHECK allowed tenant B insert") }
let cross_update := db_execute(db, "UPDATE qf_tenant_rows SET value = 'tampered' WHERE organization_id = 'tenant_b'", [])
let cross_delete := db_execute(db, "DELETE FROM qf_tenant_rows WHERE organization_id = 'tenant_b'", [])
let cross_claim := db_execute(db, "UPDATE qf_jobs SET status = 'claimed' WHERE organization_id = 'tenant_b'", [])
if cross_update != 0 || cross_delete != 0 || cross_claim != 0 { throw("RLS allowed cross-tenant mutation or claim") }

# Return with an open transaction. Reset must roll it back and clear tenant state.
db_begin(db)
db_execute(db, "INSERT INTO qf_commands (organization_id, command_id) VALUES ('tenant_a', $1)", [rolled_back_command])
db_execute(db, "INSERT INTO qf_events (organization_id, event_id) VALUES ('tenant_a', $1)", [rolled_back_event])
db_pool_release(pool, db)
let clean := db_pool_acquire(pool)
let setting := db_query(clean, "SELECT COALESCE(current_setting('app.organization_id', true), '') AS organization_id", [])
if setting[0]["organization_id"] != "" { throw("pool checkout leaked tenant session state") }
db_execute(clean, "SET app.organization_id = 'tenant_a'", [])
let rolled_back := db_query(clean, "SELECT (SELECT COUNT(*) FROM qf_commands WHERE command_id = $1)::BIGINT AS commands, (SELECT COUNT(*) FROM qf_events WHERE event_id = $2)::BIGINT AS events", [rolled_back_command, rolled_back_event])
if rolled_back[0]["commands"] != 0 || rolled_back[0]["events"] != 0 { throw("pool reset did not roll back abandoned command/event transaction") }

# State, event, and outbox commit together.
db_begin(clean)
db_execute(clean, "INSERT INTO qf_commands (organization_id, command_id) VALUES ('tenant_a', $1)", [committed_command])
db_execute(clean, "INSERT INTO qf_events (organization_id, event_id) VALUES ('tenant_a', $1)", [committed_event])
db_execute(clean, "INSERT INTO qf_outbox (organization_id, outbox_id) VALUES ('tenant_a', $1)", [committed_outbox])
db_commit(clean)
let committed := db_query(clean, "SELECT (SELECT COUNT(*) FROM qf_commands WHERE command_id = $1)::BIGINT AS commands, (SELECT COUNT(*) FROM qf_events WHERE event_id = $2)::BIGINT AS events, (SELECT COUNT(*) FROM qf_outbox WHERE outbox_id = $3)::BIGINT AS outbox", [committed_command, committed_event, committed_outbox])
if committed[0]["commands"] != 1 || committed[0]["events"] != 1 || committed[0]["outbox"] != 1 { throw("state/event/outbox did not commit atomically") }

# A forced fault rolls back all three writes inside a database subtransaction.
let forced_fault := db_query(clean, "SELECT qf_try_atomic_fault($1, $2, $3, $4) AS committed", [fault_command, fault_event, fault_outbox, committed_command])
if forced_fault[0]["committed"] != false { throw("forced transaction fault did not occur") }
let faulted := db_query(clean, "SELECT (SELECT COUNT(*) FROM qf_commands WHERE command_id = $1)::BIGINT AS commands, (SELECT COUNT(*) FROM qf_events WHERE event_id = $2)::BIGINT AS events, (SELECT COUNT(*) FROM qf_outbox WHERE outbox_id = $3)::BIGINT AS outbox", [fault_command, fault_event, fault_outbox])
if faulted[0]["commands"] != 0 || faulted[0]["events"] != 0 || faulted[0]["outbox"] != 0 { throw("forced fault did not roll back atomically") }

# Two overlapping transactions claim distinct work with SKIP LOCKED.
db_execute(worker, "SET app.organization_id = 'tenant_a'", [])
db_begin(clean)
db_begin(worker)
let claim_one := db_query(clean, "UPDATE qf_jobs SET status = 'claimed', claimed_by = 'worker-one', leased_until = CURRENT_TIMESTAMP + INTERVAL '5 minutes' WHERE job_id = (SELECT job_id FROM qf_jobs WHERE status = 'ready' ORDER BY job_id FOR UPDATE SKIP LOCKED LIMIT 1) RETURNING job_id", [])
let claim_two := db_query(worker, "UPDATE qf_jobs SET status = 'claimed', claimed_by = 'worker-two', leased_until = CURRENT_TIMESTAMP + INTERVAL '5 minutes' WHERE job_id = (SELECT job_id FROM qf_jobs WHERE status = 'ready' ORDER BY job_id FOR UPDATE SKIP LOCKED LIMIT 1) RETURNING job_id", [])
if len(claim_one) != 1 || len(claim_two) != 1 || claim_one[0]["job_id"] == claim_two[0]["job_id"] { throw("concurrent workers duplicated or lost a claim") }
db_commit(clean)
db_commit(worker)

# An expired worker lease is recoverable without disturbing a live lease.
db_execute(clean, "UPDATE qf_jobs SET leased_until = CURRENT_TIMESTAMP - INTERVAL '1 minute' WHERE job_id = $1", [claim_one[0]["job_id"]])
let recovered_lease := db_query(clean, "UPDATE qf_jobs SET status = 'ready', claimed_by = NULL, leased_until = NULL WHERE job_id = (SELECT job_id FROM qf_jobs WHERE status = 'claimed' AND leased_until < CURRENT_TIMESTAMP ORDER BY job_id FOR UPDATE SKIP LOCKED LIMIT 1) RETURNING job_id", [])
if len(recovered_lease) != 1 || recovered_lease[0]["job_id"] != claim_one[0]["job_id"] { throw("expired worker lease was not recovered safely") }
let live_lease := db_query(clean, "SELECT status, claimed_by FROM qf_jobs WHERE job_id = $1", [claim_two[0]["job_id"]])
if len(live_lease) != 1 || live_lease[0]["status"] != "claimed" || live_lease[0]["claimed_by"] != "worker-two" { throw("lease recovery disturbed a live worker lease") }

# Kill one idle backend. Checkout must evict it and create a healthy replacement.
let worker_pid := db_query(worker, "SELECT pg_backend_pid()::BIGINT AS pid", [])[0]["pid"]
db_pool_release(pool, worker)
let killer := db_connect_postgres_tls(killer_connection_string, ca_pem)
if type(killer) == "error" { throw("test backend terminator could not connect") }
let killed := db_query(killer, "SELECT pg_terminate_backend($1) AS killed", [worker_pid])
if len(killed) != 1 || killed[0]["killed"] != true { throw("test backend termination failed") }
db_close(killer)
let recovered := db_pool_acquire(pool)
let recovery_query := db_query(recovered, "SELECT 1::BIGINT AS value", [])
if recovery_query[0]["value"] != 1 { throw("pool did not recover a broken connection") }
db_pool_release(pool, recovered)
db_pool_release(pool, clean)
let ready := db_pool_stats(pool)
if ready["available"] != 2 || ready["in_use"] != 0 || ready["health_check_failures"] < 1 || ready["evictions"] < 1 { throw("pool recovery counters are inconsistent") }
db_pool_close(pool)
let closed := db_pool_stats(pool)
if closed["closed"] != 1 || closed["total"] != 0 { throw("pool close did not drain idle connections") }

# Maximum lifetime eviction is enforced; query timeout has a separate hostile probe.
let short_pool := db_pool_postgres_tls(connection_string, ca_pem, {
    "min_connections": 1,
    "max_connections": 1,
    "acquisition_timeout_ms": 200,
    "connect_timeout_ms": 3000,
    "idle_timeout_seconds": 60,
    "max_lifetime_seconds": 1,
    "statement_timeout_ms": 100,
    "health_check": true
})
sleep(1100)
let fresh := db_pool_acquire(short_pool)
let configured_timeout := db_query(fresh, "SELECT current_setting('statement_timeout') AS timeout", [])
if configured_timeout[0]["timeout"] != "100ms" { throw("statement timeout was not applied") }
db_pool_release(short_pool, fresh)
let short_stats := db_pool_stats(short_pool)
if short_stats["evictions"] < 1 { throw("maximum connection lifetime did not evict") }
db_pool_close(short_pool)

print(to_json({
    "ok": true,
    "schema": "dev.kujolang.postgres-tls-pool-rls.v1",
    "tls": "verified",
    "roles": "separated",
    "rls": "forced",
    "session_reset": "verified",
    "atomicity": "verified",
    "claims": "distinct",
    "expired_leases": "recovered",
    "recovery": "verified",
    "timeouts": "bounded"
}))

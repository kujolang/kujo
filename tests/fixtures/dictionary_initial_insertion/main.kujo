from owner import snapshot, edit, edit_then_error, replace_root, insert_named

let original := snapshot()
let first := edit()
assert_equal(original, {"seed": 7})
assert_equal(first, {"seed": 7, "0": 11})
let expanded := snapshot()
assert_equal(len(expanded), 7)
assert_equal(expanded["long noncanonical inserted key"], 23)
mut caught := false
try { edit_then_error() } except e { caught = true }
assert(caught)
assert_equal(has_key(expanded, "before error"), 0)
assert_equal(snapshot()["before error"], 31)
let replaced := replace_root()
assert_equal(replaced["before replacement"], 37)
assert_equal(has_key(replaced, "after replacement"), 0)
assert_equal(snapshot(), {"replacement": 41, "after replacement": 43})
assert_equal(original, {"seed": 7})
assert_equal(first, {"seed": 7, "0": 11})
let before_named := snapshot()
assert_equal(insert_named("new string key", null), null)
assert_equal(insert_named(-268435457, false), false)
assert_equal(insert_named(268435456, 2.5), 2.5)
assert_equal(has_key(before_named, "new string key"), 0)
assert_equal(has_key(before_named, -268435457), 0)
assert_equal(has_key(before_named, 268435456), 0)
assert_equal(snapshot()["-268435457"], false)
assert_equal(snapshot()["268435456"], 2.5)
print("INITIAL INSERTION CONTRACT PASS")

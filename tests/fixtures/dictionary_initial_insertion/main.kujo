from cold import cold_reset, cold_fill, cold_snapshot, cold_step
from owner import snapshot, edit, edit_then_error, replace_root, insert_named, insert_pair

let original := snapshot()
let first := edit()
assert_equal(original, {"seed": 7})
assert_equal(first, {"seed": 7, "0": 11})
let expanded := snapshot()
assert_equal(len(expanded), 7)
assert_equal(expanded["long noncanonical inserted key"], 23)
mut caught := false
try { edit_then_error() } except e { caught = true }
assert(caught)
assert_equal(has_key(expanded, "before error"), 0)
assert_equal(snapshot()["before error"], 31)
let replaced := replace_root()
assert_equal(replaced["before replacement"], 37)
assert_equal(has_key(replaced, "after replacement"), 0)
assert_equal(snapshot(), {"replacement": 41, "after replacement": 43})
assert_equal(original, {"seed": 7})
assert_equal(first, {"seed": 7, "0": 11})
let before_named := snapshot()
assert_equal(insert_named("new string key", null), null)
assert_equal(insert_named(-268435457, false), false)
assert_equal(insert_named(268435456, 2.5), 2.5)
assert_equal(has_key(before_named, "new string key"), 0)
assert_equal(has_key(before_named, -268435457), 0)
assert_equal(has_key(before_named, 268435456), 0)
assert_equal(snapshot()["-268435457"], false)
assert_equal(snapshot()["268435456"], 2.5)
let before_pair := snapshot()
assert_equal(insert_pair(1000, 47, null), 47)
assert_equal(insert_pair(1002, false, 3.5), false)
assert_equal(has_key(before_pair, 1000), 0)
assert_equal(snapshot()[1000], 47)
assert_equal(snapshot()[1001], null)
assert_equal(snapshot()[1002], false)
assert_equal(snapshot()[1003], 3.5)
// The first insertion has no saved owner alias. Dynamic loop bounds exercise
// both ordinary small-map mutation and profitable sparse publication.
for width in [0, 1, 2, 128, 2048] {
    cold_reset(width)
    assert_equal(cold_step(), width + 1)
    assert_equal(cold_fill(width, 64), width)
    let saved := cold_snapshot()
    assert_equal(cold_fill(width + 64, 257), width + 64)
    assert_equal(len(saved), width + 64)
    assert_equal(has_key(saved, width + 64), 0)
    let current := cold_snapshot()
    assert_equal(len(current), width + 321)
    mut j := 0
    while j < width { assert_equal(current[j], 0) j += 1 }
    while j < width + 321 { assert_equal(current[j], j) j += 1 }
}
print("INITIAL INSERTION CONTRACT PASS")

struct Selector {
 value: int,
 func op_add(other) {
  let saved := state
  assert_equal(saved[0], 7)
  state = {0: 99}
  assert_equal(saved[0], 7)
  return value + other
 }
}
mut selectors := [Selector { value: 0 }]
mut state := {0: 0, 1: 0, 2: 0}
export func snapshot() { return state }
export func edit() {
 state[0] = 7
 state[1] = 8
 let index := selectors[0]
 return state[index + 0]
}
